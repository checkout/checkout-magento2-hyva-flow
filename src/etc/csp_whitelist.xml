<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <!-- PayPal SDK: https://www.paypal.com/sdk/js (initPaypalButton factory). -->
        <policy id="script-src">
            <values>
                <value id="paypal_www" type="host">www.paypal.com</value>
                <value id="paypal_www_sandbox" type="host">www.sandbox.paypal.com</value>
                <value id="paypal_objects" type="host">www.paypalobjects.com</value>
                <value id="paypal_analytics" type="host">t.paypal.com</value>
                <value id="checkoutcom-script" type="host">*.checkout.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="paypal_www" type="host">www.paypal.com</value>
                <value id="paypal_www_sandbox" type="host">www.sandbox.paypal.com</value>
                <value id="paypal_objects" type="host">www.paypalobjects.com</value>
                <value id="checkoutcom-frame" type="host">*.checkout.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="paypal_www" type="host">www.paypal.com</value>
                <value id="paypal_www_sandbox" type="host">www.sandbox.paypal.com</value>
                <value id="paypal_objects" type="host">www.paypalobjects.com</value>
                <value id="paypal_analytics" type="host">t.paypal.com</value>
                <value id="checkoutcom-img" type="host">*.checkout.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="paypal_www" type="host">www.paypal.com</value>
                <value id="paypal_www_sandbox" type="host">www.sandbox.paypal.com</value>
                <value id="paypal_objects" type="host">www.paypalobjects.com</value>
                <value id="checkoutcom-connect" type="host">*.checkout.com</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="paypal_objects" type="host">www.paypalobjects.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
