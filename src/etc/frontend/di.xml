<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="CheckoutCom\Magento2\Model\Service\PaymentContextRequestService">
        <plugin name="checkoutcom_hyva_paypal_populate_payer_name"
                type="CheckoutCom\Magento2Hyva\Plugin\Paypal\PopulatePayerName"/>
    </type>
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="checkoutcom-express" xsi:type="string">CheckoutCom\Magento2Hyva\CustomerData\ExpressCheckout</item>
            </argument>
        </arguments>
    </type>
    <type name="Hyva\CompatModuleFallback\Model\CompatModuleRegistry">
        <arguments>
            <argument name="compatModules" xsi:type="array">
                <item name="checkoutcom_magento2_hyva_map" xsi:type="array">
                    <item name="original_module" xsi:type="string">CheckoutCom_Magento2</item>
                    <item name="compat_module" xsi:type="string">CheckoutCom_Magento2Hyva</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
