declare(strict_types=1);

use Magento\Checkout\Helper\Data as CheckoutHelper;
use Magento\Framework\Escaper;
use Magento\Tax\Block\Checkout\Grandtotal;

/** @var Grandtotal $block */
/** @var Escaper $escaper */

$colspan = (int) $block->getColspan();
/** @var CheckoutHelper $checkoutHelper */
$checkoutHelper = $block->getData('checkoutHelper');
$markCellClass = 'py-3 pe-4 text-left font-semibold text-fg align-top';
$amountCellClass = 'py-3 text-right text-lg font-semibold align-top';
?>
<?php if ($block->includeTax() && $block->getTotalExclTax() >= 0): ?>
    <tr class="border-t border-slate-200">
        <th class="<?= $escaper->escapeHtmlAttr($markCellClass) ?>" colspan="<?= $colspan ?>" scope="row">
            <?= $escaper->escapeHtml(__('Grand Total Excl. Tax')) ?>
        </th>
        <td class="<?= $escaper->escapeHtmlAttr($amountCellClass) ?>" data-th="<?= $escaper->escapeHtmlAttr(__('Grand Total Excl. Tax')) ?>">
            <?= /* @noEscape */ $checkoutHelper->formatPrice($block->getTotalExclTax()) ?>
        </td>
    </tr>
    <?= /* @noEscape */ $block->renderTotals('taxes', $colspan) ?>
    <tr class="border-t border-slate-200">
        <th class="<?= $escaper->escapeHtmlAttr($markCellClass) ?>" colspan="<?= $colspan ?>" scope="row">
            <?= $escaper->escapeHtml(__('Grand Total Incl. Tax')) ?>
        </th>
        <td class="<?= $escaper->escapeHtmlAttr($amountCellClass) ?>" data-th="<?= $escaper->escapeHtmlAttr(__('Grand Total Incl. Tax')) ?>">
            <?= /* @noEscape */ $checkoutHelper->formatPrice($block->getTotal()->getValue()) ?>
        </td>
    </tr>
<?php else: ?>
    <tr class="border-t border-slate-200">
        <th class="<?= $escaper->escapeHtmlAttr($markCellClass) ?>" colspan="<?= $colspan ?>" scope="row">
            <?= $escaper->escapeHtml($block->getTotal()->getTitle()) ?>
        </th>
        <td class="<?= $escaper->escapeHtmlAttr($amountCellClass) ?>" data-th="<?= $escaper->escapeHtmlAttr($block->getTotal()->getTitle()) ?>">
            <?= /* @noEscape */ $checkoutHelper->formatPrice($block->getTotal()->getValue()) ?>
        </td>
    </tr>
<?php endif; ?>
